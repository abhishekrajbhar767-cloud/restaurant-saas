# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import into client components.
# Used only in: scripts/admin tooling that must bypass RLS (e.g. hard-deleting a
# restaurant). Ordinary app requests should never need this — RLS + the
# SECURITY DEFINER functions in the migrations do the trusted work instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full site URL, used for building QR code links (section 25)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Capacitor Android WebView. Use a LAN IP while developing (`http://192.168.x.x:3000`)
# so the phone can reach your Next.js server. Production APKs should point at the
# deployed site. Leave unset only if you are not building the staff app.
CAPACITOR_SERVER_URL=http://192.168.1.10:3000

# Firebase Cloud Messaging (server). Download a service account JSON from
# Firebase Console → Project settings → Service accounts. Never ship these
# to the client; they are used only by lib/push/fcm.ts.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional shared secret for Database Webhooks posting to /api/staff-alerts/dispatch
STAFF_ALERTS_SECRET=generate-a-long-random-string
