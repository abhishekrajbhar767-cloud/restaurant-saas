# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import into client components.
# Used only in: scripts/admin tooling that must bypass RLS (e.g. hard-deleting a
# restaurant). Ordinary app requests should never need this — RLS + the
# SECURITY DEFINER functions in the migrations do the trusted work instead.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Full site URL, used for building QR code links (section 25)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
